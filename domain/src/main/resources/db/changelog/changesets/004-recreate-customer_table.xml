<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
           http://www.liquibase.org/xml/ns/dbchangelog
           http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="004" author="ndd">

        <sql>DROP TABLE IF EXISTS customer CASCADE;</sql>
        <sql>DROP SEQUENCE IF EXISTS customer_id_seq1;</sql>
        <sql>DROP SEQUENCE IF EXISTS customer_id_seq;</sql>

        <createSequence
                sequenceName="customer_id_seq"
                startValue="1"
                incrementBy="1"/>

        <createTable tableName="customer">
            <column name="id" type="BIGINT">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name1" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="name2" type="VARCHAR(255)"/>
            <column name="name3" type="VARCHAR(255)"/>
            <column name="lastname1" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="lastname2" type="VARCHAR(255)"/>
            <column name="lastname3" type="VARCHAR(255)"/>
            <column name="fullname" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="person_type" type="INTEGER">
                <constraints nullable="false"/>
            </column>
            <column name="document_type" type="INTEGER">
                <constraints nullable="false"/>
            </column>
            <column name="document_number" type="INTEGER">
                <constraints nullable="false"/>
            </column>
            <column name="customer_type" type="INTEGER">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="INTEGER">
                <constraints nullable="false"/>
            </column>
            <column name="last_modification_date" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addDefaultValue
                tableName="customer"
                columnName="id"
                defaultValueSequenceNext="customer_id_seq"/>

        <addUniqueConstraint
                tableName="customer"
                columnNames="document_type, document_number"
                constraintName="uk_customer_document"/>

    </changeSet>

</databaseChangeLog>
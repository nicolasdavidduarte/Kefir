<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
           http://www.liquibase.org/xml/ns/dbchangelog
           http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="018" author="ndd">

        <createTable tableName="operation_log">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="entity" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="entity_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="operation" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="comments" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="user_id" type="SMALLINT">
                <constraints nullable="false"
                    foreignKeyName="fk_operation_log_core_user"
                    referencedTableName="core_user"
                    referencedColumnNames="id"/>
            </column>
            <column name="operation_date" type="TIMESTAMPTZ" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

    </changeSet>

</databaseChangeLog>
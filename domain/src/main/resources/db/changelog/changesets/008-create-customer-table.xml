<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
           http://www.liquibase.org/xml/ns/dbchangelog
           https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="008" author="ndd">

        <createTable tableName="customer">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name1" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="name2" type="VARCHAR(20)"/>
            <column name="name3" type="VARCHAR(20)"/>
            <column name="lastname1" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="lastname2" type="VARCHAR(20)"/>
            <column name="lastname3" type="VARCHAR(20)"/>
            <column name="fullname" type="VARCHAR(120)">
                <constraints nullable="false"/>
            </column>
            <column name="person_type_id" type="SMALLINT">
                <constraints nullable="false" foreignKeyName="fk_customer_person_type"
                             references="person_type(id)"/>
            </column>
            <column name="document_type_id" type="SMALLINT">
                <constraints nullable="false" foreignKeyName="fk_customer_document_type"
                             references="document_type(id)"/>
            </column>
            <column name="document_number" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="customer_type_id" type="SMALLINT">
                <constraints nullable="false" foreignKeyName="fk_customer_customer_type"
                             references="customer_type(id)"/>
            </column>
            <column name="email" type="VARCHAR(50)">
                <constraints nullable="true"/>
            </column>
            <column name="status" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="SMALLINT">
                <constraints nullable="false" foreignKeyName="fk_customer_core_user_creation"
                             references="core_user(id)"/>
            </column>
            <column name="created_at" type="TIMESTAMPTZ" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_by" type="SMALLINT">
                <constraints nullable="false" foreignKeyName="fk_customer_core_user_update"
                             references="core_user(id)"/>
            </column>
            <column name="updated_at" type="TIMESTAMPTZ" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addUniqueConstraint
                tableName="customer"
                columnNames="document_type_id, document_number"
                constraintName="uk_customer_document"/>

    </changeSet>

</databaseChangeLog>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
           http://www.liquibase.org/xml/ns/dbchangelog
           http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="009" author="ndd">

        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="account"/>
            </not>
        </preConditions>

        <createSequence
                sequenceName="account_id_seq"
                startValue="1"
                incrementBy="1"/>

        <createTable tableName="account">
            <column name="id" type="BIGINT" defaultValueComputed="nextval('account_id_seq')">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="type" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_account_account_type"
                referencedTableName="account_type"
                referencedColumnNames="id"/>
            </column>
            <column name="customer" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_account_customer"
                referencedTableName="customer"
                referencedColumnNames="id"/>
            </column>
            <column name="currency" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_account_currency"
                referencedTableName="currency"
                referencedColumnNames="id"/>
            </column>
            <column name="bank" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_account_bank"
                referencedTableName="bank"
                referencedColumnNames="id"/>
            </column>
            <column name="CBU" type="VARCHAR(22)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uk_account_cbu"/>
            </column>
            <column name="balance" type="NUMERIC(12,2)">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="INTEGER">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMPTZ">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMPTZ">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addDefaultValue
                tableName="account"
                columnName="id"
                defaultValueSequenceNext="account_id_seq"/>

    </changeSet>

</databaseChangeLog>
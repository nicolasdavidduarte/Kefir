<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
           http://www.liquibase.org/xml/ns/dbchangelog
           http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="017" author="ndd">

        <createTable tableName="loan_installment">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="loan_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_loan_installment_loan"
                referencedTableName="loan"
                referencedColumnNames="id"/>
            </column>
            <column name="number" type="SMALLINT">
                <constraints nullable="false"/>
            </column>
            <column name="principal_amount" type="NUMERIC(19,4)">
                <constraints nullable="false"/>
            </column>
            <column name="interest_amount" type="NUMERIC(19,4)">
                <constraints nullable="false"/>
            </column>
            <column name="total_amount" type="NUMERIC(19,4)">
                <constraints nullable="false"/>
            </column>
            <column name="payment_due_date" type="TIMESTAMPTZ">
                <constraints nullable="false"/>
            </column>
            <column name="remaining_balance" type="NUMERIC(19,4)">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="user_id" type="SMALLINT">
                <constraints nullable="false" foreignKeyName="fk_loan_installment_core_user"
                             referencedTableName="core_user"
                             referencedColumnNames="id"/>
            </column>
            <column name="created_at" type="TIMESTAMPTZ" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMPTZ" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addUniqueConstraint
                tableName="loan_installment"
                columnNames="loan_id, number"
                constraintName="uk_loan_installment_number"/>

    </changeSet>

</databaseChangeLog>
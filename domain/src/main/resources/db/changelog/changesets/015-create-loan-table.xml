<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
           http://www.liquibase.org/xml/ns/dbchangelog
           http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="015a" author="ndd">
        <preConditions onFail="HALT">
            <not>
                <tableExists tableName="loan_status"/>
            </not>
        </preConditions>

        <createSequence
                sequenceName="loan_status_id_seq"
                startValue="1"
                incrementBy="1"/>

        <createTable tableName="loan_status">
            <column name="id" type="SMALLINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(20)">
                <constraints nullable="true"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="015b" author="ndd">

        <preConditions onFail="HALT">
            <not>
                <tableExists tableName="loan"/>
            </not>
        </preConditions>

        <createSequence
                sequenceName="loan_id_seq"
                startValue="1"
                incrementBy="1"/>

        <createTable tableName="loan">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="customer_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_loan_customer"
                             referencedTableName="customer"
                             referencedColumnNames="id"/>
            </column>
            <column name="loan_type_id" type="SMALLINT">
                <constraints nullable="false" foreignKeyName="fk_loan_loan_type"
                             referencedTableName="loan_type"
                             referencedColumnNames="id"/>
            </column>
            <column name="number_of_installments" type="SMALLINT">
                <constraints nullable="false"/>
            </column>
            <column name="currency_id" type="SMALLINT">
                <constraints nullable="false" foreignKeyName="fk_loan_currency"/>
            </column>
            <column name="total_operation_amount" type="NUMERIC(19,4)">
                <constraints nullable="false"/>
            </column>
            <column name="opening_date" type="TIMESTAMPTZ">
                <constraints nullable="false"/>
            </column>
            <column name="expiration_date" type="TIMESTAMPTZ">
                <constraints nullable="false"/>
            </column>
            <column name="external_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="status_id" type="SMALLINT">
                <constraints nullable="false" foreignKeyName="fk_loan_loan_status"
                referencedTableName="loan_status"
                             referencedColumnNames="id"
                />
            </column>
            <column name="user_id" type="SMALLINT">
                <constraints nullable="false" foreignKeyName="fk_loan_core_user"
                             referencedTableName="core_user"
                             referencedColumnNames="id"/>
            </column>
            <column name="created_at" type="TIMESTAMPTZ" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMPTZ" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addUniqueConstraint tableName="loan"
                             columnNames="external_id"
                             constraintName="uk_external_id"
                             validate="true"/>

    </changeSet>

</databaseChangeLog>
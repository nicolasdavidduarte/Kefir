<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
           http://www.liquibase.org/xml/ns/dbchangelog
           https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="016" author="ndd">

        <createTable tableName="loan">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="customer_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_loan_customer"
                             references="customer(id)"/>
            </column>
            <column name="account_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_loan_account"
                             references="account(id)"/>
            </column>
            <column name="loan_type_id" type="SMALLINT">
                <constraints nullable="false" foreignKeyName="fk_loan_loan_type"
                             references="loan_type(id)"/>
            </column>
            <column name="number_of_installments" type="SMALLINT">
                <constraints nullable="false"/>
            </column>
            <column name="currency_id" type="SMALLINT">
                <constraints nullable="false" foreignKeyName="fk_loan_currency"
                             references="currency(id)"/>
            </column>
            <column name="amortization_type_id" type="SMALLINT">
                <constraints nullable="false" foreignKeyName="fk_loan_amortization_type"
                             references="amortization_type(id)"/>
            </column>
            <column name="annual_interest_rate" type="NUMERIC(19,4)">
                <constraints nullable="false"/>
            </column>
            <column name="monthly_interest_rate" type="NUMERIC(19,4)">
                <constraints nullable="false"/>
            </column>
            <column name="principal_amount" type="NUMERIC(19,4)">
                <constraints nullable="false"/>
            </column>
            <column name="interest_amount" type="NUMERIC(19,4)">
                <constraints nullable="false"/>
            </column>
            <column name="total_operation_amount" type="NUMERIC(19,4)">
                <constraints nullable="false"/>
            </column>
            <column name="opening_date" type="TIMESTAMPTZ">
                <constraints nullable="false"/>
            </column>
            <column name="expiration_date" type="TIMESTAMPTZ">
                <constraints nullable="false"/>
            </column>
            <column name="external_id" type="BIGINT">
                <constraints nullable="true"/>
            </column>
            <column name="status" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="SMALLINT">
                <constraints nullable="false" foreignKeyName="fk_loan_core_user_creation"
                             references="core_user(id)"/>
            </column>
            <column name="created_at" type="TIMESTAMPTZ" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_by" type="SMALLINT">
                <constraints nullable="false" foreignKeyName="fk_loan_core_user_update"
                             references="core_user(id)"/>
            </column>
            <column name="updated_at" type="TIMESTAMPTZ" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addUniqueConstraint tableName="loan"
                             columnNames="external_id"
                             constraintName="uk_external_id"
                             validate="true"/>

    </changeSet>

</databaseChangeLog>
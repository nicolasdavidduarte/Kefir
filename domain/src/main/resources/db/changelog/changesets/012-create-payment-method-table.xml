<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
           http://www.liquibase.org/xml/ns/dbchangelog
           http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="012" author="ndd">

        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="payment_method"/>
            </not>
        </preConditions>

        <createSequence
                sequenceName="payment_method_id_seq"
                startValue="1"
                incrementBy="1"/>

        <createTable tableName="payment_method">
            <column name="id" type="SMALLINT" defaultValueComputed="nextval('payment_method_id_seq')">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="INTEGER">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMPTZ">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMPTZ">
                <constraints nullable="false"/>
            </column>
        </createTable>

    </changeSet>

</databaseChangeLog>
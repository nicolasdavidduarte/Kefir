<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
           http://www.liquibase.org/xml/ns/dbchangelog
           https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="012" author="ndd">

        <createTable tableName="account">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="type_id" type="SMALLINT">
                <constraints nullable="false" foreignKeyName="fk_account_account_type"
                             references="account_type(id)"/>
            </column>
            <column name="customer_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_account_customer"
                             references="customer(id)"/>
            </column>
            <column name="currency_id" type="SMALLINT">
                <constraints nullable="false" foreignKeyName="fk_account_currency"
                             references="currency(id)"/>
            </column>
            <column name="bank_id" type="SMALLINT">
                <constraints nullable="false" foreignKeyName="fk_account_bank"
                             references="bank(id)"/>
            </column>
            <column name="CBU" type="VARCHAR(22)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uk_account_cbu"/>
            </column>
            <column name="balance" type="NUMERIC(19,4)">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="SMALLINT">
                <constraints nullable="false" foreignKeyName="fk_account_core_user_creation"
                             references="core_user(id)"/>
            </column>
            <column name="created_at" type="TIMESTAMPTZ" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_by" type="SMALLINT">
                <constraints nullable="false" foreignKeyName="fk_account_core_user_update"
                             references="core_user(id)"/>
            </column>
            <column name="updated_at" type="TIMESTAMPTZ" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

    </changeSet>

</databaseChangeLog>
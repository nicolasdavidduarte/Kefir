<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
           http://www.liquibase.org/xml/ns/dbchangelog
           http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="003" author="ndd">

        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="user_role"/>
            </not>
        </preConditions>

        <createTable tableName="user_role">
            <column name="user_id" type="SMALLINT">
                <constraints primaryKey="true" nullable="false"
                foreignKeyName="fk_user_role_user"
                referencedTableName="core_user"
                referencedColumnNames="id"/>
            </column>
            <column name="role_id" type="SMALLINT">
                <constraints primaryKey="true" nullable="false"
                foreignKeyName="fk_user_role_role"
                referencedTableName="role"
                referencedColumnNames="id"/>
            </column>
            <column name="enabled" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMPTZ" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMPTZ" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

    </changeSet>

</databaseChangeLog>
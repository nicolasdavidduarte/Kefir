<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
           http://www.liquibase.org/xml/ns/dbchangelog
           http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="005_2" author="ndd">

        <preConditions onFail="HALT">
            <columnExists tableName="loan_type" columnName="name"/>
            <columnExists tableName="loan_type" columnName="status"/>
        </preConditions>

        <addNotNullConstraint tableName="loan_type" columnName="name"/>
        <addNotNullConstraint tableName="loan_type" columnName="status"/>

    </changeSet>

</databaseChangeLog>
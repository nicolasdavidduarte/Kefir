<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
           http://www.liquibase.org/xml/ns/dbchangelog
           https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="010" author="ndd">

        <createTable tableName="bank_branch">
            <column name="id" type="SMALLINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="branch_number" type="SMALLINT">
                <constraints nullable="false"/>
            </column>
            <column name="bank_id" type="SMALLINT">
                <constraints nullable="false" foreignKeyName="fk_bank_branch_bank"
                             references="bank(id)"/>
            </column>
            <column name="name" type="VARCHAR(50)">
                <constraints nullable="false" />
            </column>
            <column name="address" type="VARCHAR(100)">
                <constraints nullable="false" />
            </column>
            <column name="status" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="SMALLINT">
                <constraints nullable="false" foreignKeyName="fk_bank_branch_core_user_creation"
                             references="core_user(id)"/>
            </column>
            <column name="created_at" type="TIMESTAMPTZ" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_by" type="SMALLINT">
                <constraints nullable="false" foreignKeyName="fk_bank_branch_core_user_update"
                             references="core_user(id)"/>
            </column>
            <column name="updated_at" type="TIMESTAMPTZ" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addUniqueConstraint
                tableName="bank_branch"
                columnNames="branch_number, bank_id"
                constraintName="uk_bank_branch"/>

    </changeSet>

</databaseChangeLog>